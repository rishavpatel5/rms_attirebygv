# Optional: absolute API URL (e.g. production CDN + API host).
# Dev: leave unset — Vite proxies `/api` to http://localhost:4000 (see vite.config.ts).
# VITE_API_URL=http://localhost:4000

# Optional: base URL for WhatsApp invoice links (<base>/i/<orderId>).
# Use your frontend URL so /i/:id opens the SPA and redirects to the API PDF.
# If unset, VITE_API_URL is used (PDF opens directly on the backend host).
# VITE_PUBLIC_INVOICE_BASE_URL=https://attirebygv-frontend-production.up.railway.app

# Store branding shown in the web UI and WhatsApp messages.
# Vite serves files in frontend/public from the web root, so this points to
# frontend/public/brand/logo.png.
VITE_STORE_NAME=Attire by GV
VITE_STORE_LOGO_PATH=/brand/logo.png
