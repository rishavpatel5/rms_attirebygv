# Optional: absolute API URL (e.g. production CDN + API host).
# Dev: leave unset — Vite proxies `/api` to http://localhost:4000 (see vite.config.ts).
# VITE_API_URL=http://localhost:4000

# Optional: public base URL for customer-facing invoice links shared on WhatsApp.
# Leave unset for now — the WhatsApp message omits the "Download your invoice" line
# until a public host is chosen. Once set, links render as <base>/i/<orderId>.
# (Requires the public invoice route to be hosted — to be added later.)
# VITE_PUBLIC_INVOICE_BASE_URL=https://attirebygv.com
