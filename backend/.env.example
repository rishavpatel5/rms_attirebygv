# PostgreSQL — Supabase
# DATABASE_URL: transaction-mode pooler (port 6543, app runtime). Add ?pgbouncer=true
# DIRECT_URL: session-mode pooler (port 5432, used by Prisma for migrations)
# URL-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
# Server
NODE_ENV=development
PORT=4000

# CORS — comma-separated origins (Vite default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# Optional: JSON logs in production
LOG_LEVEL=info

# JWT — use strong random strings (32+ chars in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars-dev
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars-dev
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# bcrypt cost (10–14)
BCRYPT_COST=12

# First-time admin only: set true once with empty DB, then disable
AUTH_BOOTSTRAP_ENABLED=false

# Store profile (invoice PDF header/footer — not stored in DB)
STORE_NAME=Attire by GV
STORE_ADDRESS=123, Main Street, Anytown, USA
STORE_PHONE=123-456-7890
STORE_EMAIL=info@attirebygv.com
STORE_GSTIN=29AAFCM0000A1Z5
# Optional absolute or backend-relative path to PNG/JPG logo.
# Local/dev and Docker image default: backend/assets/logo.png -> assets/logo.png
STORE_LOGO_PATH=assets/logo.png
STORE_INVOICE_THANK_YOU=Thank you for shopping with us. We look forward to seeing you again.
STORE_RETURN_POLICY=Returns & exchanges within 7 days with original bill and tags intact.

WHATSAPP_ENABLED           = true
WATI_BASE_URL              = 
WATI_ACCESS_TOKEN          = 
WATI_INVOICE_TEMPLATE_NAME = 
WATI_BROADCAST_NAME        = 
PUBLIC_API_BASE_URL        = 
